# Add to the server's Caddyfile, then `caddy reload` (or reload the Caddy container).
# Cloudflare DNS for auth.amilliontechies.com is DNS-only, so Caddy obtains the
# certificate itself.
#
# The admin console and the master realm are not served publicly; reach them
# through an SSH tunnel instead:  ssh -L 8080:127.0.0.1:8080 <server>
# The amilliontechies realm's Admin REST API (/admin/realms/amilliontechies/...)
# stays reachable: product backends on other hosts call it with their service
# account's token, and it rejects anything without one.
auth.amilliontechies.com {
	@blocked path /admin /admin/ /admin/master/* /admin/amilliontechies/console* /admin/realms/master/* /realms/master/*
	respond @blocked 404

	# Keycloak sends `/` to the admin console, which only exists behind the tunnel
	# (localhost:8080). Send visitors to their account page instead.
	redir / /realms/amilliontechies/account/

	# Caddy runs in Docker on PROXY_NETWORK, where Keycloak is `amt-keycloak`.
	# (A Caddy installed on the host would use 127.0.0.1:8080 instead.)
	reverse_proxy amt-keycloak:8080
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}
