# Copy to .env on the server (never commit it) and fill in.

# Public URL of the identity server. Tokens carry it as their issuer.
KC_HOSTNAME=https://auth.amilliontechies.com

# Where the admin console is served (its own Caddy site, see Caddyfile.snippet).
# Set to http://localhost:8080 to keep it behind an SSH tunnel instead.
KC_HOSTNAME_ADMIN=https://auth-admin.amilliontechies.com

# The Docker network the server's Caddy container is on; Keycloak joins it.
# Find it with: docker inspect <caddy container> --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=g8-yatch_g8net

# Image to run. Bump the tag to upgrade (see README.md).
KEYCLOAK_IMAGE=ghcr.io/milliontechies/amt-keycloak:26.8.2-1

# Keycloak's database password. Generate one: openssl rand -base64 32
DB_PASSWORD=

# First start only: a temporary admin to sign in with. Delete both lines once
# you have created your own admin account, then `docker compose up -d`.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# deploy.sh reruns the realm setup on every deploy for these products
# (space-separated name=URL[,URL...], see scripts/keycloak-prod-setup.sh). The first
# URL is the product's site; others are extra places its web app may sign in from,
# here developers running Community locally against this server...
PRODUCTS=community=https://community.amilliontechies.com,http://localhost:5173
# ...signing in with the amt-deploy service account. The setup prints its secret
# the first time it runs; paste it here.
KC_ADMIN_CLIENT_SECRET=

# Email (verification, "Forgot password?"). deploy.sh applies these to the
# amilliontechies realm on every deploy; a deploy from GitHub fails without them.
# Zoho: smtppro.zoho.com for a domain account (smtp.zoho.com is for personal ones).
# With 2FA on the Zoho account, SMTP_PASSWORD is an app-specific password.
# SMTP_FROM must be the account itself or one of its aliases.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=info@amilliontechies.com
SMTP_PASSWORD=
SMTP_FROM=info@amilliontechies.com
SMTP_FROM_NAME=A Million Techies
# Port 465 instead: SMTP_SSL=true and SMTP_STARTTLS=false.

# Backups (backup.sh): an rclone remote and bucket path for the off-server copy,
# e.g. r2:amt-keycloak-backups. Configure the remote with `rclone config`.
BACKUP_REMOTE=
